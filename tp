    function openCabinetDrawer(drawerKey) {
      const targetDrawer = document.querySelector(`.push-drawer[data-drawer="${drawerKey}"]`);
      if (targetDrawer) {
        targetDrawer.classList.add('drawer-activating');
      }

      triggerTactileSound(true);
      monolithConsole.classList.add('console-receded');

      setTimeout(() => {
        activateDockModule(drawerKey);
        drawerStageOverlay.classList.add('is-open');
        if (targetDrawer) {
          targetDrawer.classList.remove('drawer-activating');
        }
      }, 150);
    }

    /**
     * Cambia el módulo activo dentro del cajón abierto
     */
    function activateDockModule(moduleKey) {
      currentOpenDrawer = moduleKey;

      dockPills.forEach(pill => {
        const isCurrent = pill.dataset.dock === moduleKey;
        if (isCurrent) {
          pill.classList.add('bg-champagne-400/20', 'text-white', 'border', 'border-champagne-400/45', 'font-semibold');
          pill.classList.remove('text-zinc-400', 'hover:text-white');
        } else {
          pill.classList.remove('bg-champagne-400/20', 'text-white', 'border', 'border-champagne-400/45', 'font-semibold');
          pill.classList.add('text-zinc-400', 'hover:text-white');
        }
      });

      drawerModules.forEach(mod => {
        if (mod.id === `module-${moduleKey}`) {
          mod.classList.remove('hidden', 'module-enter');
          void mod.offsetWidth;
          mod.classList.add('module-enter');
        } else {
          mod.classList.add('hidden');
          mod.classList.remove('module-enter');
        }
      });

      drawerScrollBody.scrollTop = 0;
    }


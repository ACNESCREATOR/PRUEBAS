    serviceSpecModal.addEventListener('click', (e) => {
      if (e.target === serviceSpecModal) {
        serviceSpecModal.classList.add('hidden');
      }
    });

    modalQuoteActionBtn.addEventListener('click', () => {
      serviceSpecModal.classList.add('hidden');
      preselectAndJumpToQuote(currentModalPreset);
    });

    document.querySelectorAll('.quick-quote-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        preselectAndJumpToQuote(btn.dataset.quickQuote);
      });
    });

    // Tecla Escape cierra modal primero si está abierto, o el cajón
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        if (!serviceSpecModal.classList.contains('hidden')) {
          serviceSpecModal.classList.add('hidden');
        } else if (currentOpenDrawer) {
          closeCabinetDrawer();
        }
      }
    });

    /* ==========================================================================
       CAJÓN 03: FILTROS DE EXPEDIENTES DE CLIENTES
       ========================================================================== */
    const expFilterBtns = document.querySelectorAll('.exp-filter-btn');
    const expedienteCards = document.querySelectorAll('.expediente-card');

    expFilterBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const category = btn.dataset.expedienteFilter;

        expFilterBtns.forEach(b => {
          b.classList.remove('bg-champagne-400', 'text-obsidian-950', 'font-semibold');
          b.classList.add('bg-white/[0.04]', 'text-zinc-300', 'border', 'border-white/10');
        });
        btn.classList.remove('bg-white/[0.04]', 'text-zinc-300', 'border', 'border-white/10');
        btn.classList.add('bg-champagne-400', 'text-obsidian-950', 'font-semibold');

        expedienteCards.forEach(card => {
          if (category === 'all' || card.dataset.expCat === category) {
            card.classList.remove('hidden');
          } else {
            card.classList.add('hidden');
          }
        });
      });
    });

    /* ==========================================================================
       CAJÓN 04: CONFIGURADOR INTELIGENTE B2B & ENVÍO WHATSAPP
       ========================================================================== */
    const b2bConfigForm = document.getElementById('b2bConfigForm');
    const guestsSlider = document.getElementById('guestsSlider');
    const guestsValueBadge = document.getElementById('guestsValueBadge');
    const configErrorMsg = document.getElementById('configErrorMsg');

    function getScaleLabel(guests) {
      if (guests <= 30) return 'Escala VIP / Privado';
      if (guests <= 85) return 'Escala Boutique';
      if (guests <= 160) return 'Salón Completo';
      return 'Gran Escala Contract';
    }

    function collectConfigState() {
      const spaceEl = document.querySelector('input[name="spaceType"]:checked');
      const space = spaceEl ? spaceEl.value : 'Restaurante';

      const furniture = Array.from(document.querySelectorAll('input[name="reqFurniture"]:checked'))
        .map(el => el.value);

      const guests = parseInt(guestsSlider.value, 10) || 60;
      const guestsDisplay = guests >= 250 ? '250+' : `${guests}`;
      const hasBlueprints = document.getElementById('blueprintsSwitch').checked;
      const clientName = document.getElementById('inputClientName').value.trim();
      const clientCity = document.getElementById('inputClientCity').value.trim();

      return { space, furniture, guests, guestsDisplay, hasBlueprints, clientName, clientCity };
    }

    function refreshLiveSummary() {
      const st = collectConfigState();

      guestsValueBadge.innerHTML = `${st.guestsDisplay} <span class="font-mono text-xs font-normal text-champagne-400">PAX</span>`;
      document.getElementById('liveSpace').textContent = st.space;
      document.getElementById('liveFurniture').textContent = st.furniture.length > 0
        ? st.furniture.join(', ')
        : 'Por definir';
      document.getElementById('liveGuests').textContent = `${st.guestsDisplay} Comensales (${getScaleLabel(st.guests)})`;
      document.getElementById('liveBlueprints').textContent = st.hasBlueprints
        ? 'Sí, cuenta con planos/renders'
        : 'Requiere levantamiento';
      document.getElementById('liveContact').textContent = (st.clientName || st.clientCity)
        ? `${st.clientName || 'Cliente'}${st.clientCity ? ' · ' + st.clientCity : ''}`
        : 'Por definir';
    }

    b2bConfigForm.addEventListener('input', refreshLiveSummary);
    b2bConfigForm.addEventListener('change', refreshLiveSummary);

    function formatB2BOrderText(st) {
      return [
        `*SOLICITUD DE PROYECTO B2B — OMEGA MUEBLES*`,
        `• *Tipo de espacio:* ${st.space}`,
        `• *Mobiliario requerido:* ${st.furniture.length > 0 ? st.furniture.join(', ') : 'A definir'}`,
        `• *Capacidad estimada:* ${st.guestsDisplay} comensales (${getScaleLabel(st.guests)})`,
        `• *Planos / Renders:* ${st.hasBlueprints ? 'Sí cuenta con planos/renders' : 'Requiere levantamiento'}`,
        `• *Nombre / Despacho:* ${st.clientName || 'No especificado'}`,
        `• *Ciudad:* ${st.clientCity || 'No especificada'}`
      ].join('\n');
    }

    // Enviar orden directa por WhatsApp
    document.getElementById('whatsappSubmitBtn').addEventListener('click', () => {
      const st = collectConfigState();
      configErrorMsg.classList.add('hidden');

      if (st.furniture.length === 0) {
        configErrorMsg.textContent = 'Selecciona al menos un elemento en el paso 02 (Booths, Sillones, Mesas, Sillas o Barra).';
        configErrorMsg.classList.remove('hidden');
        return;
      }

      if (!st.clientName || !st.clientCity) {
        configErrorMsg.textContent = 'Ingresa tu nombre (o despacho) y la ciudad del proyecto para preparar tu cotización.';
        configErrorMsg.classList.remove('hidden');
        return;
      }

      const encoded = encodeURIComponent(formatB2BOrderText(st));
      window.open(`https://wa.me/${WHATSAPP_NUMBER}?text=${encoded}`, '_blank', 'noopener,noreferrer');
    });

    // Copiar cotización al portapapeles (compatible con iframe)
    document.getElementById('copySummaryBtn').addEventListener('click', () => {
      const st = collectConfigState();
      const plainText = formatB2BOrderText(st).replace(/\*/g, '');

      const tempInput = document.createElement('textarea');
      tempInput.value = plainText;
      tempInput.style.position = 'fixed';
      tempInput.style.opacity = '0';
      document.body.appendChild(tempInput);
      tempInput.select();

      try {
        document.execCommand('copy');
        const toast = document.getElementById('copyFeedbackToast');
        toast.classList.remove('hidden');
        setTimeout(() => toast.classList.add('hidden'), 2600);
      } catch (e) {
        // Silencio seguro
      }
// Inicializar resumen en vivo
    refreshLiveSummary();
  </script>
</body>
</html>

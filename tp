  <style>
    /* ==========================================================================
       SISTEMA VISUAL ARQUITECTÓNICO — OMEGA MUEBLES (POLIFORM / BOFFI INSPIRED)
       ========================================================================== */
    :root {
      --bg-obsidian: #0B0C0E;
      --wood-smoked: #161412;
      --led-champagne: #D9A86C;
      --ease-architectural: cubic-bezier(0.16, 1, 0.3, 1);
    }

    * {
      box-sizing: border-box;
      -webkit-tap-highlight-color: transparent;
    }

    body {
      background-color: var(--bg-obsidian);
      color: #F3F4F6;
      font-family: 'Plus Jakarta Sans', sans-serif;
      height: 100dvh;
      width: 100vw;
      margin: 0;
      overflow: hidden;
    }

    /* Ambiente de galería arquitectónica con retícula milimétrica sutil */
    .architectural-stage {
      background-color: #0B0C0E;
      background-image:
        radial-gradient(circle at 50% 0%, rgba(217, 168, 108, 0.08) 0%, rgba(11, 12, 14, 0) 58%),
        linear-gradient(to right, rgba(255, 255, 255, 0.018) 1px, transparent 1px),
        linear-gradient(to bottom, rgba(255, 255, 255, 0.018) 1px, transparent 1px);
      background-size: 100% 100%, 48px 48px, 48px 48px;
    }

    /* Textura de madera listonada oscura / nogal ahumado (#161412) */
    .slatted-walnut {
      background-color: #161412;
      background-image:
        repeating-linear-gradient(
          90deg,
          rgba(0, 0, 0, 0.42) 0px,
          rgba(0, 0, 0, 0.42) 1.5px,
          rgba(255, 255, 255, 0.018) 1.5px,
          rgba(255, 255, 255, 0.018) 12px,
          rgba(0, 0, 0, 0.25) 12px,
          rgba(0, 0, 0, 0.25) 14px
        ),
        linear-gradient(180deg, rgba(255, 255, 255, 0.03) 0%, rgba(0, 0, 0, 0.35) 100%);
    }

    /* Estructura monolítica de la credenza/consola */
    .monolith-console {
      background: linear-gradient(180deg, #121316 0%, #090A0C 100%);
      border: 1px solid rgba(255, 255, 255, 0.08);
      box-shadow:
        0 40px 90px -20px rgba(0, 0, 0, 0.95),
        0 0 0 1px rgba(217, 168, 108, 0.08),
        inset 0 1px 0 rgba(255, 255, 255, 0.06);
      perspective: 1800px;
      transition: transform 0.65s var(--ease-architectural), filter 0.65s ease;
    }

    .monolith-console.console-receded {
      transform: scale(0.96) translateY(-10px);
      filter: brightness(0.35) blur(2px);
      pointer-events: none;
    }

    /* Cajón individual Push-to-Open (sin jaladeras vintage) */
    .push-drawer {
      position: relative;
      transform-style: preserve-3d;
      border: 1px solid rgba(255, 255, 255, 0.055);
      box-shadow:
        inset 0 1px 0 rgba(255, 255, 255, 0.05),
        inset 0 -8px 18px rgba(0, 0, 0, 0.65),
        0 10px 24px rgba(0, 0, 0, 0.7);
      transition:
        transform 0.5s var(--ease-architectural),
        border-color 0.35s ease,
        box-shadow 0.5s var(--ease-architectural);
      cursor: pointer;
      overflow: hidden;
    }

    /* Ranura arquitectónica superior con difusor LED indirecto */
    .led-recess-strip {
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 2px;
      background: linear-gradient(90deg, transparent 5%, rgba(217, 168, 108, 0.18) 50%, transparent 95%);
      transition: all 0.45s var(--ease-architectural);
    }

    .led-ambient-wash {
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 44px;
      background: linear-gradient(180deg, rgba(217, 168, 108, 0.16) 0%, rgba(217, 168, 108, 0) 100%);
      opacity: 0;
      transition: opacity 0.45s var(--ease-architectural);
      pointer-events: none;
    }

    /* Interacción Hover: Encendido LED + Adelantamiento monolítico */
    @media (hover: hover) {
      .push-drawer:hover {
        transform: translateY(-2px) translateZ(28px) scale(1.012);
        border-color: rgba(217, 168, 108, 0.45);
        box-shadow:
          inset 0 1px 0 rgba(217, 168, 108, 0.4),
          inset 0 -10px 22px rgba(0, 0, 0, 0.85),
          0 24px 44px -8px rgba(0, 0, 0, 0.95),
          0 0 30px rgba(217, 168, 108, 0.08);
        z-index: 20;
      }

      .push-drawer:hover .led-recess-strip {
        height: 2px;
        background: linear-gradient(90deg, transparent 2%, #D9A86C 50%, transparent 98%);
        box-shadow: 0 0 16px 2px rgba(217, 168, 108, 0.75);
      }

      .push-drawer:hover .led-ambient-wash {
        opacity: 1;
      }

      .push-drawer:hover .push-indicator {
        opacity: 1;
        transform: translateX(0);
      }
    }

    /* Estado cuando el usuario hace clic (apertura push-to-open) */
    .push-drawer.drawer-activating {
      transform: translateY(10px) translateZ(95px) scale(1.03);
      border-color: #D9A86C;
      z-index: 30;
    }

    .push-drawer.drawer-activating .led-recess-strip {
      background: #D9A86C;
      box-shadow: 0 0 24px 3px rgba(217, 168, 108, 0.9);
    }

    /* ==========================================================================
       INTERIOR DE CAJÓN ABIERTO + DOCK FLOTANTE DE CRISTAL ESMERILADO
       ========================================================================== */
    .drawer-stage-overlay {
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.45s var(--ease-architectural);
    }

    .drawer-stage-overlay.is-open {
      opacity: 1;
      pointer-events: auto;
    }

    .drawer-interior-shell {
      background: rgba(14, 15, 18, 0.92);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border: 1px solid rgba(217, 168, 108, 0.24);
      box-shadow:
        0 35px 90px rgba(0, 0, 0, 0.95),
        inset 0 1px 0 rgba(255, 255, 255, 0.08);
      transform: translateY(48px) scale(0.95);
      opacity: 0;
      transition:
        transform 0.55s var(--ease-architectural),
        opacity 0.4s ease;
    }

    .drawer-stage-overlay.is-open .drawer-interior-shell {
      transform: translateY(0) scale(1);
      opacity: 1;
    }

    /* Glassmorphism tarjetas Bento */
    .bento-glass {
      background: rgba(255, 255, 255, 0.022);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border: 1px solid rgba(255, 255, 255, 0.075);
      transition: border-color 0.35s ease, background-color 0.35s ease, transform 0.35s var(--ease-architectural);
    }

    .bento-glass:hover {
      border-color: rgba(217, 168, 108, 0.32);
      background: rgba(255, 255, 255, 0.032);
    }

    /* Animación de entrada de panel interior */
    .module-enter {
      animation: moduleFadeSlide 0.45s var(--ease-architectural) forwards;
    }

    @keyframes moduleFadeSlide {
      from {
        opacity: 0;
        transform: translateY(14px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    /* Scrollbar minimalista oscuro */
    .studio-scroll::-webkit-scrollbar {
      width: 5px;
      height: 5px;
    }
    .studio-scroll::-webkit-scrollbar-track {
      background: rgba(255, 255, 255, 0.02);
    }
    .studio-scroll::-webkit-scrollbar-thumb {
      background: rgba(217, 168, 108, 0.28);
      border-radius: 9999px;
    }
    .studio-scroll::-webkit-scrollbar-thumb:hover {
      background: rgba(217, 168, 108, 0.55);
    }

    .no-scrollbar::-webkit-scrollbar {
      display: none;
    }
    .no-scrollbar {
      -ms-overflow-style: none;
      scrollbar-width: none;
    }

    /* Texturas de materiales para el Estudio Interactivo (Cajón 01) */
    .mat-tex-nogal {
      background:
        repeating-linear-gradient(90deg, rgba(0, 0, 0, 0.35) 0px, transparent 2px, rgba(255, 255, 255, 0.03) 8px),
        linear-gradient(135deg, #3A271B 0%, #1C130D 100%);
    }
    .mat-tex-acero {
      background:

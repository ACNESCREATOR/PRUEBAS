    }
    .mat-tex-boucle {
      background:
        radial-gradient(rgba(255, 255, 255, 0.16) 1.5px, transparent 1.5px),
        radial-gradient(rgba(0, 0, 0, 0.25) 1.5px, #9E9486 1.5px);
      background-size: 6px 6px;
      background-position: 0 0, 3px 3px;
    }
    .mat-tex-laton {
      background:

     * Cierra el cajón y devuelve la consola monolítica al frente
     */
    function closeCabinetDrawer() {
      if (!currentOpenDrawer) return;
      triggerTactileSound(false);
      drawerStageOverlay.classList.remove('is-open');
      monolithConsole.classList.remove('console-receded');
      currentOpenDrawer = null;
